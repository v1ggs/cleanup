<?xml version="1.0"?>
<ruleset name="WordPress Coding Standards">
	<!-- See https://github.com/squizlabs/PHP_CodeSniffer/wiki/Annotated-ruleset.xml -->
	<!-- See https://github.com/WordPress/WordPress-Coding-Standards -->
	<!-- See https://github.com/sirbrillig/phpcs-variable-analysis -->
	<!-- See https://github.com/PHPCompatibility/PHPCompatibilityWP -->

	<!-- Set a description for this ruleset. -->
	<description>A custom set of code standard rules to check.</description>

	<!--
	#############################################################################
	COMMAND LINE ARGUMENTS
	https://github.com/squizlabs/PHP_CodeSniffer/wiki/Annotated-ruleset.xml
	#############################################################################
	-->

	<!--
	Pass some flags to PHPCS:
	p flag: Show progress of the run.
	s flag: Show sniff codes in all reports.
	v flag: Print verbose output.
	n flag: Do not print warnings.
	-->
	<arg value="ps" />

	<!-- Strip the filepaths down to the relevant bit. -->
	<arg name="basepath" value="./" />

	<!-- Check up to 8 files simultaneously. -->
	<arg name="parallel" value="8" />

	<!-- Check PHP files only. -->
	<arg name="extensions" value="php" />

	<!-- Check all files in this directory and the directories below it. -->
	<file>.</file>

	<!-- Exclude patterns. -->
	<exclude-pattern>/.vscode/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<!-- WordPress core (web root) is not plugin code. -->
	<exclude-pattern>/wordpress/*</exclude-pattern>
	<!-- Reference snippets, not shipped plugin code. -->
	<exclude-pattern>/snippets/*</exclude-pattern>
	<!-- Bootstrap defines a deliberate global WP_Admin_Bar test double. -->
	<exclude-pattern>/tests/bootstrap.php</exclude-pattern>

	<!--
	#############################################################################
	RULESETS
	#############################################################################
	-->

	<!-- RULESETS CONFIG -->
	<!-- Config for Various sniffs -->
	<!-- Prior to WordPressCS 3.0.0, the setting name for CLI was called
	minimum_supported_wp_version. -->
	<config name="minimum_wp_version" value="7.0" />
	<!-- Config for PHPCompatibilityWP (minimum PHP version supported) -->
	<config name="testVersion" value="8.2-" />

	<!-- PSR12 -->
	<rule ref="PSR12">
		<!-- Overrides example:
		 <exclude name="PSR12.Problematic.Sniff.Here" />
		-->
		<exclude name="PSR1.Files.SideEffects.FoundWithSymbols" />
		<exclude name="Generic.Files.LineLength.TooLong" />
		<!-- The file-level docblock must follow the opening PHP tag in the file header -->
		<exclude name="PSR12.Files.FileHeader.IncorrectOrder" />
	</rule>

	<!-- Various sniffs:
	Sniffs that check for usage of deprecated WP functions, function parameters and capabilities.
	https://github.com/WordPress/WordPress-Coding-Standards/wiki/Customizable-sniff-properties#various-sniffs-set-the-minimum-supported-wp-version
	-->
	<rule ref="WordPress.DB.DirectDatabaseQuery" />
	<rule ref="WordPress.DB.PreparedSQLPlaceholders" />
	<rule ref="WordPress.DB.RestrictedFunctions" />
	<rule ref="WordPress.WP.AlternativeFunctions">
		<!-- Tests use PHP file operations to create temporary config fixtures. -->
		<exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_file_put_contents" />
		<exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_mkdir" />
		<exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_unlink" />
		<exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_rmdir" />
		<exclude name="WordPress.WP.AlternativeFunctions.unlink_unlink" />
	</rule>
	<rule ref="WordPress.WP.Capabilities" />
	<rule ref="WordPress.WP.DeprecatedClasses" />
	<rule ref="WordPress.WP.DeprecatedFunctions" />
	<rule ref="WordPress.WP.DeprecatedParameters" />
	<rule ref="WordPress.WP.DeprecatedParameterValues" />

	<!-- WordPress security rules -->
	<rule ref="WordPress.Security" />
	<rule ref="WordPress.PHP.DevelopmentFunctions" />

	<!-- Internationalization: text domain must match the plugin slug. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="code-repo" />
			</property>
		</properties>
	</rule>

	<!-- DocBlocks for functions, classes and methods. -->
	<rule ref="WordPress-Docs">
		<!-- PSR-12 owns file-header formatting (blank line after <?php). -->
		<exclude name="Squiz.Commenting.FileComment.SpacingAfterOpen" />
	</rule>

	<!-- PHP compatibility rules for WordPress -->
	<rule ref="PHPCompatibilityWP">
		<!-- Deprecated: https://github.com/PHPCSStandards/PHP_CodeSniffer/issues/921 -->
		<exclude name="Generic.Functions.CallTimePassByReference" />
	</rule>
</ruleset>
