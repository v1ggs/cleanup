#!/bin/sh
# Conventional Commits check. Git passes the message file path as $1.
set -eu

msg_file=${1:-}
if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
    echo "commit-msg hook: missing message file" >&2
    exit 1
fi

subject=$(head -n 1 "$msg_file")
types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
pattern="^(${types})(\\([a-z0-9._/-]+\\))?!?: .{1,100}$"

if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
    cat >&2 <<'EOF'
Invalid commit message. Expected:

  type(scope): subject

- type: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
- scope: optional, lowercase (letters, digits, ., _, -, /)
- subject: 1-100 characters, lowercase start
- no trailing period

Examples:
  feat(config): add per-key validation
  fix(hooks): reject malformed commit messages
  docs: update setup steps
EOF
    exit 1
fi

case "$subject" in
    *.)
        echo "commit-msg hook: subject must not end with a period" >&2
        exit 1
        ;;
esac

exit 0
